# Copia este archivo como .env y llena los valores
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=tu_service_role_key
# Clave compartida con la API de Adopciones (la misma en ambos servicios)
SERVICE_API_KEY=cambia-esta-clave
# Orígenes permitidos para CORS, separados por coma (* = todos)
CORS_ORIGINS=*
# Descomenta para probar sin Supabase (datos en memoria)
# DB_MODE=memory
