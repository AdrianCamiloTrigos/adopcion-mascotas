# Copia este archivo como .env y llena los valores
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=tu_service_role_key
# URL de la API de Mascotas (local o desplegada, sin / al final)
MASCOTAS_API_URL=http://localhost:8001
# Clave compartida con la API de Mascotas (la misma en ambos servicios)
SERVICE_API_KEY=cambia-esta-clave
CORS_ORIGINS=*
# Segundos de espera al llamar a la API de Mascotas (Render gratis tarda en despertar)
HTTP_TIMEOUT=60
# DB_MODE=memory
